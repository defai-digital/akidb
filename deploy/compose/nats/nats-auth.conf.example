# NATS JetStream Configuration for AkiDB — authenticated variant (EXAMPLE)
#
# Drop-in replacement for nats.conf that requires authentication. To enable:
#   1. Copy this file over the mounted nats.conf (or mount it instead).
#   2. Replace BOTH placeholder passwords below with real secrets — do not
#      commit real credentials; inject them via deploy/compose/secrets/ and
#      env substitution in your deployment tooling.
#   3. Configure the clients:
#      - upload-gateway: UPLOAD_GATEWAY_NATS_USER / UPLOAD_GATEWAY_NATS_PASSWORD
#        (or UPLOAD_GATEWAY_NATS_PASSWORD_FILE for Docker secrets)
#      - ingestion-orchestrator: NATS_USER / NATS_PASSWORD
#        (or NATS_PASSWORD_FILE)
#
# 3-node cluster with JetStream enabled

# Server identification (set via command line --name flag)
# server_name is provided via --name argument in docker-compose

# Client connections
port: 4222
http_port: 8222

# Authentication: least-privilege users for each client role.
# The gateway may only publish upload events; the orchestrator may subscribe
# to the upload stream and publish to the DLQ stream.
authorization {
  users = [
    {
      user: "upload-gateway"
      password: "REPLACE_ME_GATEWAY_PASSWORD"
      permission: {
        publish: {
          allow: ["seaweedfs.uploads", "seaweedfs.uploads.>"]
        }
      }
    },
    {
      user: "ingestion-orchestrator"
      password: "REPLACE_ME_ORCHESTRATOR_PASSWORD"
      permission: {
        # JetStream pull consumers need subscribe on $JS.API subjects; keep
        # the data-plane subjects tight and leave the API surface open only
        # to this user.
        subscribe: {
          allow: ["seaweedfs.uploads", "seaweedfs.uploads.>", "$JS.API.>", "_INBOX.>"]
        }
        publish: {
          allow: ["akidb-dlq.>", "$JS.API.>", "_INBOX.>"]
        }
      }
    }
  ]
}

# Three-node cluster used by the Compose stack.
cluster {
  port: 6222
  name: akidb-cluster
}

# JetStream storage for each cluster member
jetstream {
  # Storage directory
  store_dir: /data/jetstream

  # Memory storage limit
  max_memory_store: 1GB

  # File storage limit
  max_file_store: 10GB
}

# Logging (stdout for container compatibility)
debug: false
trace: false
logtime: true

# Limits
max_connections: 10000
max_payload: 8MB
max_pending: 64MB

# Ping/Pong for connection health
ping_interval: "30s"
ping_max: 3

# Write deadline for slow consumers
write_deadline: "10s"

# Leaf nodes (for future expansion)
leafnodes {
  port: 7422
}

# Monitoring
# Accessible at http://localhost:8222/varz, /connz, /routez, /subsz, /jsz
