# AkiDB Thor Edition - Production Environment Template
# Copy to .env and fill in values before deployment

# ============================================
# MinIO Credentials
# ============================================
MINIO_ROOT_USER=akidb-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Storage Configuration
# ============================================
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
STORAGE_BUCKET=akidb-documents
STORAGE_REGION=us-east-1

# ============================================
# NATS Configuration
# ============================================
NATS_URL=nats://nats-1:4222,nats://nats-2:4222,nats://nats-3:4222
NATS_STREAM=akidb-uploads
NATS_CONSUMER=ingestion-orchestrator
NATS_DLQ_STREAM=akidb-dlq

# ============================================
# AkiDB Configuration
# ============================================
AKIDB_ENDPOINT=http://akidb-server:50051
AKIDB_TIMEOUT_MS=60000
AKIDB_MAX_RETRIES=5

# ============================================
# Embedding Service
# ============================================
EMBEDDING_URL=http://embedding:8000
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ============================================
# Python Parser Service
# ============================================
DOC_PARSER_URL=http://doc-parser:8080

# ============================================
# Grafana Credentials
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://monitoring.your-domain.com

# ============================================
# Thor-Specific Settings
# ============================================
# GPU Memory Utilization (0.0-1.0)
GPU_MEMORY_UTILIZATION=0.8

# Jetson Power Mode (15W, 30W, 50W, MAXN)
JETSON_POWER_MODE=MAXN

# ============================================
# Logging
# ============================================
RUST_LOG=info,akidb_ingestion=info
RUST_BACKTRACE=1

# ============================================
# Security (for production)
# ============================================
# TLS Certificate paths (if using TLS)
# TLS_CERT_PATH=/certs/server.crt
# TLS_KEY_PATH=/certs/server.key

# ============================================
# Alerting (optional)
# ============================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# PAGERDUTY_INTEGRATION_KEY=xxx
