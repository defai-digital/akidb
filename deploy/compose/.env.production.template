# AkiDB AMD64 Compose deployment overrides
#
# Copy this file to .env. Store credentials only in the ignored files under
# deploy/compose/secrets/:
#   minio_root_user.txt
#   minio_root_password.txt
#   grafana_admin_password.txt

# Shared NATS stream. Clients discover the remaining cluster nodes from nats-1.
NATS_URL=nats://nats-1:4222
NATS_STREAM=INGESTION
NATS_CONSUMER=ingestion-orchestrator
NATS_DLQ_STREAM=akidb-dlq
NATS_REPLICAS=3

# Ingestion service
AKIDB_TIMEOUT_MS=60000
AKIDB_MAX_RETRIES=5
EMBEDDING_URL=http://host.docker.internal:8000
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=https://monitoring.your-domain.com

# Logging
RUST_LOG=info,akidb_ingestion=info
RUST_BACKTRACE=1
