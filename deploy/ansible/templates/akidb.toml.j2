# AkiDB Configuration for {{ hostname }}
# Generated by Ansible

[server]
host = "0.0.0.0"
port = 8080
grpc_port = {{ grpc_port }}
tls_enabled = false

[index]
index_type = "IVF4096,Flat"
nlist = 4096
nprobe = 32

[index.gpu]
enabled = true
device_id = 0
memory_fraction = 0.6
fallback_to_cpu = true

[index.rebuild]
tombstone_ratio_trigger = 0.10
max_duration_seconds = 300
preferred_hours = [2, 3, 4]

[index.tombstone]
use_gpu_bitset = true
max_count = 100000

[storage]
rocksdb_path = "{{ akidb_data_dir }}/rocksdb"
wal_enabled = true
wal_path = "{{ akidb_data_dir }}/wal"

[storage.minio]
endpoint = "localhost:9000"
bucket = "{{ minio_bucket }}"
access_key = "akidb-admin"
secret_key = "akidb-secret-key"
use_ssl = false

[observability]
tracing_enabled = true
otlp_endpoint = "http://localhost:4317"
metrics_enabled = true
metrics_port = 9090
log_level = "info"
log_format = "json"

[slo]
[slo.reference]
dimensions = 768
vectors_per_shard = 1000000
top_k = 10
nprobe = 32
batch_size = 1
target_p95_ms = 50

[slo.backpressure]
soft_breach_ms = 50
hard_breach_ms = 75
degraded_mode_enabled = true

[cluster]
shard_id = {{ shard_id }}
is_coordinator = {{ is_coordinator | lower }}
# Other shards in the cluster
{% if inventory_hostname == 'thor-01' %}
peers = ["192.168.1.62:{{ grpc_port }}"]
{% else %}
peers = ["192.168.1.61:{{ grpc_port }}"]
{% endif %}
