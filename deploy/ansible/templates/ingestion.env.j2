# AkiDB Ingestion Pipeline - Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ ansible_hostname }}

# ============================================
# MinIO Credentials
# ============================================
MINIO_ROOT_USER={{ minio_root_user | default('akidb-admin') }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# ============================================
# Storage Configuration
# ============================================
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
STORAGE_BUCKET={{ minio_bucket | default('akidb-documents') }}
STORAGE_REGION={{ minio_region | default('us-east-1') }}

# ============================================
# NATS Configuration
# ============================================
NATS_URL=nats://nats-1:4222,nats://nats-2:4222,nats://nats-3:4222
NATS_STREAM=akidb-uploads
NATS_CONSUMER=ingestion-orchestrator
NATS_DLQ_STREAM=akidb-dlq

# ============================================
# AkiDB Configuration
# ============================================
AKIDB_ENDPOINT=http://{{ akidb_server_host | default('akidb-server') }}:50051
AKIDB_TIMEOUT_MS={{ akidb_timeout_ms | default(60000) }}
AKIDB_MAX_RETRIES={{ akidb_max_retries | default(5) }}

# ============================================
# Embedding Service
# ============================================
EMBEDDING_URL=http://{{ embedding_host | default('embedding') }}:8000
EMBEDDING_MODEL={{ embedding_model | default('Qwen/Qwen3-Embedding-8B') }}

# ============================================
# Python Parser Service
# ============================================
DOC_PARSER_URL=http://doc-parser:8080

# ============================================
# Grafana Credentials
# ============================================
GRAFANA_ADMIN_USER={{ grafana_admin_user | default('admin') }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
GRAFANA_ROOT_URL={{ grafana_root_url | default('http://localhost:3000') }}

# ============================================
# Thor-Specific Settings
# ============================================
GPU_MEMORY_UTILIZATION={{ gpu_memory_utilization | default(0.8) }}
JETSON_POWER_MODE={{ jetson_power_mode | default('MAXN') }}

# ============================================
# Logging
# ============================================
RUST_LOG={{ rust_log_level | default('info,akidb_ingestion=info') }}
RUST_BACKTRACE={{ rust_backtrace | default(1) }}

# ============================================
# Ingestion Configuration
# ============================================
# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD={{ circuit_breaker_threshold | default(5) }}
CIRCUIT_BREAKER_RESET_SECS={{ circuit_breaker_reset_secs | default(60) }}
CIRCUIT_BREAKER_HALF_OPEN_CALLS={{ circuit_breaker_half_open_calls | default(3) }}

# Backpressure
BACKPRESSURE_LATENCY_THRESHOLD_MS={{ backpressure_latency_threshold_ms | default(500) }}
BACKPRESSURE_QUEUE_DEPTH={{ backpressure_queue_depth | default(20000) }}
BACKPRESSURE_PAUSE_SECS={{ backpressure_pause_secs | default(10) }}

# Memory
MEMORY_PAUSE_THRESHOLD_PCT={{ memory_pause_threshold_pct | default(75) }}
MEMORY_RESUME_THRESHOLD_PCT={{ memory_resume_threshold_pct | default(65) }}

# Batcher
BATCHER_MIN_BATCH={{ batcher_min_batch | default(32) }}
BATCHER_MAX_BATCH={{ batcher_max_batch | default(128) }}
BATCHER_TIMEOUT_MS={{ batcher_timeout_ms | default(200) }}

# Chunker
CHUNKER_TARGET_TOKENS={{ chunker_target_tokens | default(512) }}
CHUNKER_MIN_OVERLAP={{ chunker_min_overlap | default(20) }}
CHUNKER_MAX_OVERLAP={{ chunker_max_overlap | default(50) }}
