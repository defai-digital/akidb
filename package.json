{
  "name": "akidb",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter '!@defai-digital/akidb-native' -r test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean --if-present && cargo clean --manifest-path packages/akidb-native/Cargo.toml 2>/dev/null; true"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
